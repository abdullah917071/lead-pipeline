# Copy to .env and fill in real values

# ─── Core ────────────────────────────────────────────────────────
DEBUG=true
DATABASE_URL=postgresql+asyncpg://pipeline:pipeline@postgres:5432/leadpipeline
REDIS_URL=redis://:pipeline@redis:6379/0

# ─── Dograh Voice AI ─────────────────────────────────────────────
DOGRAH_API_URL=http://dograh:8000
DOGRAH_API_KEY=your_dograh_jwt_secret
DOGRAH_AGENT_ID=1
DOGRAH_WEBHOOK_SECRET=your_webhook_signing_secret

# ─── Telephony (Twilio — required for Indian outbound calls) ─────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ─── WhatsApp Business API (Meta Cloud) ─────────────────────────
WA_API_URL=https://graph.facebook.com/v21.0
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_BUSINESS_ACCOUNT_ID=your_business_account_id
WA_ACCESS_TOKEN=your_permanent_system_user_token
WA_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token
WA_WEBHOOK_APP_SECRET=your_app_secret

# ─── UPI / Payment ──────────────────────────────────────────────
UPI_MERCHANT_NAME=YourPlatform
PAYMENT_SESSION_EXPIRY_MINUTES=15
_PAYMENT_POLL_INTERVAL_SECONDS=30
MAX_PAYMENT_REMINDERS=1

# ─── Platform API (your backend) ────────────────────────────────
PLATFORM_API_URL=http://platform:8000
PLATFORM_API_KEY=your_platform_api_key
PLATFORM_APP_DOWNLOAD_URL=https://yourplatform.in/download

# ─── QR Generation ──────────────────────────────────────────────
QR_SERVICE=local
QUICKCHART_URL=https://quickchart.io/qr

# ─── Payment Gateway (Razorpay — dynamic QR + webhook) ──────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_API_URL=https://api.razorpay.com/v1

# ─── Amount Limits ───────────────────────────────────────────────
MIN_AMOUNT_INR=5
MAX_AMOUNT_INR=100000

# ─── WhatsApp Opt-in Template ────────────────────────────────────
WA_OPTIN_TEMPLATE_NAME=suppremo_welcome
WA_OPTIN_IMAGE_URL=https://suppremo.in/assets/wa-welcome.jpg

# ─── SMS Reconciler webhook ──────────────────────────────────────
SMS_LISTENER_SECRET=your_sms_webhook_secret

# ─── Cron / Rotation ─────────────────────────────────────────────
UPI_ROTATION_TIME_IST=00:01
