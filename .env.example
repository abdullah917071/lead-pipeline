# Copy to .env and replace all CHANGEME values. Never commit .env.
DEBUG=false

# Orchestrator database/cache
DATABASE_URL=postgresql+asyncpg://pipeline:pipeline@postgres:5432/leadpipeline
REDIS_URL=redis://:pipeline@redis:6379/0

# Dograh / Telnyx voice workflow
DOGRAH_API_URL=http://dograh:8000
DOGRAH_API_KEY=CHANGEME
DOGRAH_TRIGGER_PATH=CHANGEME_WORKFLOW_TRIGGER_UUID
DOGRAH_TELEPHONY_CONFIG_ID=3
DOGRAH_WORKFLOW_ID=1
DOGRAH_DATABASE_URL=postgresql+asyncpg://dograh:dograh_pg@dograh-postgres:5432/dograh
MIDCALL_POLL_INTERVAL_SECONDS=1

# Meta WhatsApp Cloud API
WA_API_URL=https://graph.facebook.com/v21.0
WA_PHONE_NUMBER_ID=CHANGEME
WA_ACCESS_TOKEN=CHANGEME
WA_WEBHOOK_VERIFY_TOKEN=CHANGEME
WA_OPTIN_TEMPLATE_NAME=CHANGEME
WA_OPTIN_IMAGE_URL=https://example.com/optin-image.jpg

# Razorpay
RAZORPAY_KEY_ID=CHANGEME
RAZORPAY_KEY_SECRET=CHANGEME
RAZORPAY_WEBHOOK_SECRET=CHANGEME
RAZORPAY_API_URL=https://api.razorpay.com/v1
MIN_AMOUNT_INR=1
MAX_AMOUNT_INR=100000
UPI_MERCHANT_NAME=Your Business
PAYMENT_SESSION_EXPIRY_MINUTES=15

# Downstream account provisioning
PLATFORM_API_URL=http://platform:8000
PLATFORM_API_KEY=CHANGEME
PLATFORM_APP_DOWNLOAD_URL=https://example.com/app

# Optional Gemini Vertex bridge
GEMINI_VERTEX_API_KEY=
GEMINI_VERTEX_PROJECT_ID=
GEMINI_VERTEX_LOCATION=us-central1
GEMINI_VERTEX_PROXY_TOKEN=
